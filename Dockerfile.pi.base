# Base image: lean pi-sandbox without heavyweight extensions.
#
# Build:
#   docker build -f Dockerfile.pi.base -t pi-sandbox:base .
#
# Used as the base for:
#   Dockerfile.pi.coding  — adds pi-subagents + RTK
#   Dockerfile.pi.wiki    — adds pi-llm-wiki
#   Dockerfile.pi.learn   — adds opencode-engram-learning

FROM node:24-trixie-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends bash ca-certificates curl fd-find git python3 ripgrep \
  && ln -s $(which fdfind) /usr/local/bin/fd \
  && rm -rf /var/lib/apt/lists/*
RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent

# Install packages via `pi install` which handles both npm install and
# settings.json registration automatically. Start with a minimal
# settings.json so pi install can merge into it rather than overwriting.
# PI_VERSION is resolved at build time and passed to node via env (VAR=val
# must precede the command, otherwise it is just a positional argument).
RUN PI_VERSION=$(node -p "require('/usr/local/lib/node_modules/@earendil-works/pi-coding-agent/package.json').version") \
  && mkdir -p /root/.pi/agent \
  && PI_VERSION="$PI_VERSION" node > /root/.pi/agent/settings.json <<'NODE'
const fs = require("fs");
const settings = {
  lastChangelogVersion: process.env.PI_VERSION,
  defaultProvider: "llamaswap",
  defaultModel: "qwen3.6-35b-a3b-instruct-general",
  defaultThinkingLevel: "medium",
  packages: [],
  theme: "dark"
};
fs.writeFileSync("/root/.pi/agent/settings.json", JSON.stringify(settings, null, 2) + "\n");
NODE
RUN pi install npm:pi-venice && pi install npm:pi-web-access && pi install npm:pi-blackhole

RUN mkdir -p /root/.pi \
  && cat > /root/.pi/web-search.json << WEBSEARCH_EOF
{
  "workflow": "auto-summary"
}
WEBSEARCH_EOF

WORKDIR /workspace
ENTRYPOINT ["pi"]
