# Extended image: pi-sandbox with coding extensions (pi-subagents + RTK).
#
# Build (directory builds default to pi-sandbox:base):
#   docker build -f Dockerfile.pi.coding -t pi-sandbox:coding .
#   docker build --build-arg BASE_IMAGE=pi-sandbox:base -f Dockerfile.pi.coding -t pi-sandbox:coding .

ARG BASE_IMAGE=pi-sandbox:base
FROM ${BASE_IMAGE}

RUN pi install npm:pi-subagents

# Install RTK (Rust Token Killer) for token-optimized command outputs
# The install script resolves the latest release version automatically.
# Pin to a specific version by setting RTK_VERSION (e.g., RTK_VERSION=0.42.4)
RUN curl -fsSL https://raw.githubusercontent.com/rtk-ai/rtk/refs/heads/master/install.sh | sh \
  && export PATH="/root/.local/bin:$PATH" \
  && rtk init -g --agent pi
ENV PATH="/root/.local/bin:$PATH"
